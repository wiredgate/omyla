{
  "name": "rapp",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-10",
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "ai": {"binding": "AI"},
  "durable_objects": {"bindings": [{"name": "RAP_BUDGET", "class_name": "RapBudget"}]},
  "migrations": [{"tag": "rapp-budget-v1", "new_sqlite_classes": ["RapBudget"]}],
  "workers_dev": true,
  "routes": [{"pattern": "rapp.uwaaa.com", "custom_domain": true}]
}
