{
  "name": "omyla",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "QUOTA",
        "class_name": "Quota"
      },
      {
        "name": "GOALS",
        "class_name": "GoalSession"
      },
      {
        "name": "CREW",
        "class_name": "CrewSession"
      }
    ]
  },
  "exports": {
    "Quota": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "GoalSession": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "CrewSession": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "TEXT_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8-fast",
    "MARGIN_BPS": 3500,
    "AGENT_MODELS": "{}",
    "PAID_MODELS_ENABLED": "false",
    "VISION_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "CREW_ENABLED": "false",
    "CREW_MODEL": "gpt-6-astra"
  },
  "routes": [
    {
      "pattern": "omyla.uwaaa.com",
      "custom_domain": true
    }
  ]
}
