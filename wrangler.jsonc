{
  "name": "omyla",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-26",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "QUOTA", "class_name": "Quota" }] },
  "exports": { "Quota": { "type": "durable-object", "storage": "sqlite" } },
  "routes": [{ "pattern": "omyla.uwaaa.com", "custom_domain": true }]
}
